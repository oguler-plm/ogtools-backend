{
  "version": 2,
  "builds": [
    { "src": "api/compare.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/compare", "dest": "/api/compare.py" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*\\.html)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
